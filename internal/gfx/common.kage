// 共用函式：由 gfx.NewShader 接在每個 shader 本體前面。

// hash13 把 vec3 映射成 [0, 1) 的亂數（Dave Hoskins, "Hash without Sine"）。
// 只用 fract 與 dot，在不同 GPU 上結果穩定。
func hash13(p3 vec3) float {
	p3 = fract(p3 * 0.1031)
	p3 += dot(p3, p3.zyx+31.32)
	return fract((p3.x + p3.y) * p3.z)
}

// binColor 從 8 種「子像素全開 / 全關」組合中隨機選一種顏色
// （黑、紅、綠、藍、青、洋紅、黃、白）。
func binColor(seed vec3) vec3 {
	r := hash13(seed)
	g := hash13(seed + vec3(17.0, 59.4, 15.0))
	b := hash13(seed + vec3(41.3, 7.7, 93.1))
	return step(vec3(0.5), vec3(r, g, b))
}

// hsv2rgb：c = (色相, 飽和度, 明度)，皆為 0–1。
func hsv2rgb(c vec3) vec3 {
	k := vec4(1.0, 2.0/3.0, 1.0/3.0, 3.0)
	p := abs(fract(c.xxx+k.xyz)*6.0 - k.www)
	return c.z * mix(k.xxx, clamp(p-k.xxx, vec3(0.0), vec3(1.0)), c.y)
}

// vnoise：平滑的 2D value noise，回傳 0–1。
func vnoise(p vec2, seed float) float {
	i := floor(p)
	f := fract(p)
	u := f * f * (3.0 - 2.0*f)
	a := hash13(vec3(i, seed))
	b := hash13(vec3(i+vec2(1.0, 0.0), seed))
	c := hash13(vec3(i+vec2(0.0, 1.0), seed))
	d := hash13(vec3(i+vec2(1.0, 1.0), seed))
	return mix(mix(a, b, u.x), mix(c, d, u.x), u.y)
}

// fbm：多層 value noise 疊加，回傳約 0–1。
func fbm(p vec2, seed float) float {
	v := 0.0
	amp := 0.5
	for i := 0; i < 4; i++ {
		v += amp * vnoise(p, seed)
		p = p*2.0 + vec2(13.1, 7.7)
		amp *= 0.5
	}
	return v / 0.9375
}
