// aurora：深色漸層色帶緩慢流動。以 domain warp 的 fbm 產生柔和的帶狀亮區。

var Resolution vec2
var Time float
var MaxBrightness float

func Fragment(dstPos vec4, srcPos vec2, color vec4) vec4 {
	pos := pixelPos(dstPos)
	uv := pos / Resolution.y // 以高度為單位，維持長寬比
	t := Time
	warp := fbm(uv*1.5+vec2(t*0.020, -t*0.015), 3.0)
	n := fbm(vec2(uv.x*1.2+t*0.030, uv.y*2.5-t*0.020)+warp*1.5, 7.0)
	band := smoothstep(0.45, 0.75, n)
	hue := fract(0.45 + uv.x*0.15 + warp*0.3 + t*0.004)
	c := hsv2rgb(vec3(hue, 0.75, band))
	return vec4(c*MaxBrightness, 1.0)
}
